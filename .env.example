# Copy to .env and fill in. Never commit real values.

DATABASE_URL=postgres://user:pass@localhost:5432/ecommerce
JWT_SECRET=
JWT_EXPIRY=7d
NEXT_PUBLIC_APP_URL=http://localhost:3000
UPLOAD_MAX_BYTES=5242880

# --- Media storage (S3-compatible) ---------------------------------------
# Dev: local RustFS/Garage. Leave S3_PUBLIC_URL empty and media is served
# through the app's /api/media proxy.
S3_ENDPOINT=http://localhost:3900
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ecommerce-uploads
S3_REGION=garage
S3_PUBLIC_URL=

# Production: Cloudflare R2 (see docs/deploy/cloudflare-r2.md)
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=<R2 token Access Key ID>
# S3_SECRET_KEY=<R2 token Secret Access Key>
# S3_BUCKET=<bucket name>
# S3_REGION=auto
# S3_PUBLIC_URL=https://media.<your-domain>

# --- Database backups (docs/deploy/db-backups.md) -------------------------
# These go in .env.backup on the server (read only by the db-backup container),
# NOT in .env.production. A separate private R2 bucket with its own API token.
# BACKUP_* values below are listed here for reference.
# BACKUP_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_BUCKET=<backup bucket name>
# BACKUP_AGE_RECIPIENT=age1...        # optional: encrypt; keep the private key off the server
# BACKUP_CRON=0 * * * *               # hourly (Asia/Dhaka)
# BACKUP_KEEP_HOURLY_HOURS=48
# BACKUP_KEEP_DAILY_DAYS=30
# BACKUP_KEEP_MONTHLY_DAYS=365

# --- Payments (fallback; stores can override with their own keys) --------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true
